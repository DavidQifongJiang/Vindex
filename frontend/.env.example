# Opt in only after the API's LIBRARY_SEARCH_ENABLED flag is enabled.
VITE_LIBRARY_SEARCH_ENABLED=false
VITE_SEARCH_ANALYTICS_ENABLED=false
# "direct" uploads from the browser straight to S3 (needed behind API Gateway's 10 MB limit;
# the bucket must allow CORS POST from the site origin). "api" streams through the API.
VITE_UPLOAD_MODE=api
