# Docker Compose Postgres settings
PGHOST=postgres
PGPORT=5432
PGUSER=vindex
PGPASSWORD=vindex
PGDATABASE=vindex

# Optional: set DATABASE_URL only when a platform provides one.
DATABASE_URL=

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_VISIBILITY_TIMEOUT_SECONDS=7200
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
# Optional shared lexical backend. API and maintenance must use the same settings.
# Compose profile: --profile search; URL: http://elasticsearch:9200
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=vindex-passages-v1
ELASTICSEARCH_RECONCILE_BATCH=10
# Durable projection lifecycle (requires Alembic 0006; disabled until rollout).
SEARCH_PROJECTIONS_ENABLED=false
LIBRARY_SEARCH_ENABLED=false
# Enables authenticated per-process Prometheus search metrics only when set.
SEARCH_METRICS_TOKEN=
SEARCH_LEXICAL_TARGET=vindex-library-passages-v1
SEARCH_SEMANTIC_TARGET=vindex_library_v1
# Pin the actual SentenceTransformer model commit to enable semantic projection.
# Existing vectors without matching provenance require explicit regeneration.
SEARCH_EMBEDDING_REVISION=
SEARCH_VECTOR_SIZE=384
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CA_CERT=

STORAGE_ROOT=storage
MAX_UPLOAD_MB=500
MAX_PROCESSING_ATTEMPTS=3
PROCESSING_RETRY_BACKOFF_BASE_SECONDS=30
PROCESSING_RETRY_BACKOFF_CAP_SECONDS=600
PROCESSING_RETRY_JITTER_RATIO=0.2
PROCESSING_LEASE_SECONDS=300
PROCESSING_DEADLINE_SECONDS=1800
MEDIA_COMMAND_TIMEOUT_SECONDS=900
UPLOAD_DEADLINE_SECONDS=1800
# Lifetime of browser-to-S3 presigned upload URLs (capped by UPLOAD_DEADLINE_SECONDS).
UPLOAD_URL_SECONDS=900
ARTIFACT_GC_GRACE_SECONDS=86400
MAINTENANCE_INTERVAL_SECONDS=60
OPERATIONS_PORT=9101
PIPELINE_DISPATCH_INTERVAL_SECONDS=5
PIPELINE_REDISPATCH_SECONDS=60
FFMPEG_PRESET=veryfast
WHISPER_MODEL=tiny
EMBEDDING_MODEL=all-MiniLM-L6-v2
SEARCH_CHUNK_SECONDS=300
SEARCH_CHUNK_OVERLAP_SECONDS=5
WORKER_OMP_NUM_THREADS=1
WORKER_MKL_NUM_THREADS=1
WORKER_OPENBLAS_NUM_THREADS=1
WORKER_NUMEXPR_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
RUN_MIGRATIONS_ON_STARTUP=true
CREATE_TABLES_ON_STARTUP=false
APP_DOMAIN=vindex.example.com

STORAGE_BACKEND=s3
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name
# Required before enabling the Compose operations profile. Version both buckets.
BACKUP_S3_BUCKET=
BACKUP_INTERVAL_SECONDS=21600
S3_PRESIGNED_URL_SECONDS=3600

AUTH_REQUIRED=false
DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@vindex.local
DEV_USER_NAME=Local Developer

COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

VITE_AUTH_ENABLED=false
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:8000/
# Optional search interaction analytics (all disabled by default).
# Use a dedicated local database for experiments. Never put private query text in Kafka.
SEARCH_EVENTS_CAPTURE_ENABLED=false
SEARCH_EVENTS_INTAKE_ENABLED=false
SEARCH_EVENTS_DASHBOARD_ENABLED=false
SEARCH_EVENTS_SYNTHETIC_ONLY=false
SEARCH_EVENTS_REVIEWERS=
SEARCH_EVENTS_KAFKA_BOOTSTRAP=127.0.0.1:19092
SEARCH_EVENTS_TOPIC=vindex.search.interactions.v1
SEARCH_EVENTS_CONFIGURATION=unversioned
SEARCH_EVENTS_OUTBOX_BYTES=1073741824
