# Docker Compose Postgres settings
PGHOST=postgres
PGPORT=5432
PGUSER=vindex
PGPASSWORD=vindex
PGDATABASE=vindex

# Optional: set DATABASE_URL only when a platform provides one.
DATABASE_URL=

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

STORAGE_ROOT=storage
MAX_UPLOAD_MB=500
WHISPER_MODEL=tiny
EMBEDDING_MODEL=all-MiniLM-L6-v2
CREATE_TABLES_ON_STARTUP=true
APP_DOMAIN=vindex.example.com

STORAGE_BACKEND=s3
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_PRESIGNED_URL_SECONDS=3600

AUTH_REQUIRED=false
DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@vindex.local
DEV_USER_NAME=Local Developer

COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

VITE_AUTH_ENABLED=false
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:8000/
