# Copy to infra/frontend.env (git-ignored). Read by infra/scripts/deploy.sh when
# building the frontend. Leave auth disabled only for a private test.
VITE_AUTH_ENABLED=true
# Hosted UI domain of your Cognito user pool, e.g. https://vindex.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
# Defaults to the CloudFront app URL + "/". Add the same URL to the app
# client's allowed callback and sign-out URLs in Cognito.
# VITE_COGNITO_REDIRECT_URI=
VITE_LIBRARY_SEARCH_ENABLED=false
VITE_SEARCH_ANALYTICS_ENABLED=false
